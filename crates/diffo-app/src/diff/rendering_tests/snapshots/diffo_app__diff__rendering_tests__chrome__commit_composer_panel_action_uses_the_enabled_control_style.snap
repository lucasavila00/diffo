Buffer {
    area: Rect { x: 0, y: 0, width: 20, height: 6 },
    content: [
        "┌ Commit message ─┐",
        "│Type a message…   │",
        "└──────────────────┘",
        "     [ Commit ]     ",
        "                    ",
        "                    ",
