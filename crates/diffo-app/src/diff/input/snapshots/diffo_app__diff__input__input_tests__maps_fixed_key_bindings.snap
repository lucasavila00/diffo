    "PageUp -> Some(ScrollDiffPageUp(1))",
    "PageDown -> Some(ScrollDiffPageDown(1))",
    "Left -> Some(ScrollDiffHorizontalBy(-4))",
    "Right -> Some(ScrollDiffHorizontalBy(4))",
    "Char('r') -> Some(ToggleDiffView)",
    "Char('m') -> Some(FocusCommitInput)",
    "Char('i') -> Some(ExecuteAiCommit)",
    "Enter -> Some(ExecuteCommit)",
    "Char('n') -> Some(JumpToNextChange)",
    "Char('p') -> Some(JumpToPreviousChange)",
    "Char(' ') -> Some(ToggleStageSelected)",
    "Char('a') -> Some(ToggleStageAll)",
]
