        Style::new().red().crossed_out(),
    ),
    (
        Renamed,
        Style::new().cyan(),
    ),
    (
        Copied,
        Style::new().cyan(),
    ),
    (
        Untracked,
        Style::new().green(),
    ),
    (
        Conflicted,
        Style::new().red(),
    ),
]
